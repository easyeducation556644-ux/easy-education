# Google Maps API Key (Optional)
# Used for displaying device locations on interactive maps in admin panel
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Configuration (Required)
# Get these from your Firebase project settings
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id

# Telegram EE/TG Upload Bot (server-side only; never expose with VITE_ prefix)
# TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
# TELEGRAM_ADMIN_IDS=123456789,987654321
# TELEGRAM_WEBHOOK_SECRET=replace_with_long_random_secret
# BOT_SETUP_SECRET=replace_with_another_long_random_secret
# BOT_CREDENTIAL_KEY=replace_with_long_random_encryption_secret
# TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/telegram-bot
# PUBLIC_APP_URL=https://your-domain.example

# Google Drive OAuth (server-side only)
# GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_DRIVE_REDIRECT_URI=https://your-domain.example/api/google-drive/callback
# GOOGLE_DRIVE_STATE_SECRET=replace_with_a_long_random_secret
# GOOGLE_DRIVE_MAX_RESOURCE_BYTES=52428800

# GitHub Actions and Vercel must use the same value.
# AUTOMATION_SECRET=replace_with_a_long_random_secret

# Operations Studio uses a separate Firebase project so task/log/cache traffic
# never consumes the Easy Education content database quota.
# OPS_FIREBASE_PROJECT_ID=easy-education-operations
# OPS_FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Udvash uses the captured official ASP.NET web flow and hardcoded Content routes.
# No UDVASH_LOGIN_URL / UDVASH_COURSES_URL / UDVASH_COURSE_CONTENT_URL variables are required.
# Optional only if the site starts requiring a different browser signature:
# UDVASH_USER_AGENT=Mozilla/5.0 ...
