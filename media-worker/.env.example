OPERATIONS_URL=https://easy-education.vercel.app
AUTOMATION_SECRET=replace-with-the-same-vercel-automation-secret
TELEGRAM_BOT_TOKEN=replace-with-bot-token

# Default hosted Bot API accepts new uploads up to 50 MB. For videos up to 2 GB,
# run Telegram's Local Bot API server and set its base URL here.
TELEGRAM_API_BASE_URL=https://api.telegram.org

WORKER_NAME=Asif-PC
WORKER_ID=asif-pc-1
WORK_DIR=./work
POLL_SECONDS=20
MIN_FREE_DISK_GB=8
YTDLP_PATH=yt-dlp
# Optional. Set to chrome, edge, or firefox only if YouTube requires login/cookies.
YOUTUBE_COOKIES_BROWSER=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CURL_PATH=curl

# Used for Bangla/English drawtext. Change if Windows is installed elsewhere.
WATERMARK_FONT=C:/Windows/Fonts/Nirmala.ttf
